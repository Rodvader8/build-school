  </ul>

  <h2>Opening hours</h2>
  <ul class="hours-list">
    <li><span>Tuesday to Friday</span> <span>7am to 2pm</span></li>
  </ul>

  <p class="contact">Call us on <a href="tel:0255500100">02 5550 0100</a></p>
</Base>
