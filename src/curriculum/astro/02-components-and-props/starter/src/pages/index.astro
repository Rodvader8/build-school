---
import Base from '../layouts/Base.astro';
---

<Base title="Saltmarsh Bakehouse | The daily bake" description="What's coming out of the Saltmarsh Bakehouse ovens today: country loaf, seeded rye and a cinnamon scroll.">
  <h1>The daily bake</h1>
  <p class="lede">Three things come out of the oven every morning. The same card, repeated three times by hand.</p>

  <div class="product-grid">
    <article class="product-card">
      <h3>Country loaf</h3>
      <p class="price">$9.00</p>
      <p>A 36-hour sourdough with a blistered crust.</p>
    </article>
    <article class="product-card">
      <h3>Seeded rye</h3>
      <p class="price">$10.50</p>
      <p>Dense, malty and covered in sunflower and pumpkin seeds.</p>
    </article>
    <article class="product-card">
      <h3>Cinnamon scroll</h3>
      <p class="price">$4.50</p>
      <p>Saturdays only, and they go by nine.</p>
    </article>
  </div>
</Base>
