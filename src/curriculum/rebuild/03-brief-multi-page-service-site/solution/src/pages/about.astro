---
import Base from '../layouts/Base.astro';
import { Picture } from 'astro:assets';
import { ironbark } from '../data/ironbark.js';
import photo from '../assets/img/about.jpg';

const page = ironbark.pages.about;
---

<Base page="about">
  <section class="page-head">
    <h1>{page.headline}</h1>
  </section>
  <section class="section split">
    <div class="story">
      {page.story.map((p) => <p>{p}</p>)}
    </div>
    <Picture class="about__img" src={photo} formats={['avif', 'webp']} widths={[480, 800]} sizes="(min-width: 56rem) 440px, 100vw" alt={ironbark.images.about} loading="eager" fetchpriority="high" />
  </section>
  <section class="section">
    <h2>The team</h2>
    <ul class="team">
      {page.team.map((t) => (
        <li class="person reveal">
          <h3>{t.name}</h3>
          <p class="person__role">{t.role}</p>
          <p>{t.bio}</p>
        </li>
      ))}
    </ul>
  </section>
  <section class="section section--tint">
    <h2>How we work</h2>
    <ul class="team">
      {page.values.map((v) => (
        <li class="person reveal">
          <h3>{v.title}</h3>
          <p>{v.body}</p>
        </li>
      ))}
    </ul>
  </section>
</Base>
