---
import Base from '../layouts/Base.astro';
import { ironbark } from '../data/ironbark.js';

const page = ironbark.pages.contact;
const options = [...ironbark.services.map((s) => s.title), ...page.serviceOptions];
---

<Base page="contact">
  <section class="page-head">
    <h1>{page.headline}</h1>
    <p class="lede">{page.intro}</p>
  </section>
  <section class="section contact">
    <form class="form" name="enquiry" method="post" data-netlify="true" netlify-honeypot="bot-field">
      <input type="hidden" name="form-name" value="enquiry" />
      <p class="form__trap"><label>Leave this empty <input name="bot-field" tabindex="-1" autocomplete="off" /></label></p>
      <div class="field">
        <label for="name">Your name</label>
        <input id="name" name="name" type="text" autocomplete="name" required />
      </div>
      <div class="field">
        <label for="email">Email</label>
        <input id="email" name="email" type="email" autocomplete="email" required />
      </div>
      <div class="field">
        <label for="phone">Phone (optional)</label>
        <input id="phone" name="phone" type="tel" autocomplete="tel" />
      </div>
      <div class="field">
        <label for="service">What do you need?</label>
        <select id="service" name="service">
          {options.map((o) => <option>{o}</option>)}
        </select>
      </div>
      <div class="field">
        <label for="message">Tell us about the garden</label>
        <textarea id="message" name="message" rows="5" required></textarea>
      </div>
      <button class="button" type="submit">Send enquiry</button>
    </form>

    <aside class="details">
      <h2>Or get in touch directly</h2>
      <p>
        <a href={`mailto:${ironbark.email}`}>{ironbark.email}</a><br />
        <a href={`tel:${ironbark.phone.replace(/\s/g, '')}`}>{ironbark.phone}</a>
      </p>
      <p>{ironbark.hours}</p>
      <p>Based in {ironbark.suburb}, serving {ironbark.area}.</p>
    </aside>
  </section>

  <section class="section">
    <h2>Common questions</h2>
    <div class="faqs">
      {page.faqs.map((f) => (
        <details class="faq">
          <summary>{f.question}</summary>
          <p>{f.answer}</p>
        </details>
      ))}
    </div>
  </section>
</Base>
