---
import '../styles/site.css';
import { Font } from 'astro:assets';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { ironbark } from '../data/ironbark.js';

const { page } = Astro.props;
const { title, description } = ironbark.pages[page];
const canonical = new URL(Astro.url.pathname, Astro.site).href;
const ogImage = new URL('/og.jpg', Astro.site).href;

const schema = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'LocalBusiness',
      '@id': `${ironbark.url}#business`,
      name: ironbark.name,
      url: ironbark.url,
      image: ogImage,
      email: ironbark.email,
      telephone: ironbark.phone,
      areaServed: ironbark.area,
      address: { '@type': 'PostalAddress', addressLocality: ironbark.suburb, addressRegion: ironbark.region, addressCountry: ironbark.country },
    },
    { '@type': 'WebPage', name: title, description, url: canonical, isPartOf: { '@id': `${ironbark.url}#business` } },
  ],
};
---

<!doctype html>
<html lang="en-AU">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta name="twitter:card" content="summary_large_image" />
    <Font cssVariable="--font-display" preload />
    <Font cssVariable="--font-body" preload />
    <script type="application/ld+json" set:html={JSON.stringify(schema)} />
  </head>
  <body>
    <a class="skip" href="#main">Skip to the content</a>
    <Header />
    <main id="main">
      <slot />
    </main>
    <Footer />
    <script>
      import '../scripts/site.js';
    </script>
  </body>
</html>
