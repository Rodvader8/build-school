---
import '../styles/site.css';
import { Font } from 'astro:assets';
import { halden } from '../data/halden.js';

const { title, description } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site).href;
const ogImage = new URL('/og.jpg', Astro.site).href;

const schema = {
  '@context': 'https://schema.org',
  '@type': 'LocalBusiness',
  name: halden.name,
  description: halden.description,
  url: halden.url,
  image: ogImage,
  email: halden.email,
  telephone: halden.phone,
  address: { '@type': 'PostalAddress', addressLocality: halden.suburb, addressRegion: halden.region, addressCountry: halden.country },
};
---

<!doctype html>
<html lang="en-AU">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="theme-color" content="#0b0a0c" />
    <link rel="canonical" href={canonical} />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta name="twitter:card" content="summary_large_image" />
    <Font cssVariable="--font-display" preload />
    <Font cssVariable="--font-body" preload />
    <script type="application/ld+json" set:html={JSON.stringify(schema)} />
  </head>
  <body>
    <slot />
  </body>
</html>
