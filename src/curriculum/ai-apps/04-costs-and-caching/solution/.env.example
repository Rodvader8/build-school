# A fake key, so the project runs on its own. Nothing here is real.
ANTHROPIC_API_KEY=test-key-not-real
# Points the SDK at the pretend API that this project serves itself. Leave it empty to talk to the real one.
CLAUDE_BASE_URL=http://127.0.0.1:4864/mock
# The most one request may cost in US dollars, worst case. The guard refuses anything above it.
MAX_REQUEST_USD=0.10
